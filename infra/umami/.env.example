# Copier en `.env` à côté de compose.yml, sur le homelab. Ne jamais versionner.

# openssl rand -base64 24
POSTGRES_PASSWORD=

# openssl rand -base64 32
# En changer la valeur déconnecte toutes les sessions Umami.
APP_SECRET=

# Tableau de bord Cloudflare → Zero Trust → Networks → Tunnels → Create a tunnel
# → Docker : le jeton figure dans la commande affichée.
TUNNEL_TOKEN=
