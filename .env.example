# Copier en `.env` pour le développement local. Toutes ces variables sont
# facultatives : à vide, le site fonctionne et ne charge aucun tiers.
# En production elles sont posées comme variables de projet GitLab CI.

# Domaine canonique. Sert aux URL canoniques, au sitemap, à robots.txt et à
# l'Open Graph. Lu par astro.config.mjs.
SITE_URL=https://cinqnotes.fr

# Mesure d'audience Umami, auto-hébergée sur le homelab et exposée par tunnel.
# Tant que ces deux variables sont vides, aucun script n'est inséré dans la page.
PUBLIC_UMAMI_URL=
PUBLIC_UMAMI_ID=

# Endpoint de capture e-mail. En production : /api/inscription, servi par la
# Cloudflare Pages Function. À vide, le formulaire affiche son message d'attente
# au lieu de prétendre avoir enregistré l'adresse.
PUBLIC_EMAIL_ENDPOINT=
